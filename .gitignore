# ---------------------------------------------------------------------------
# Repository scope
# ---------------------------------------------------------------------------

# Keep archived experiments and their drafts completely outside Git.
/OLD experiment/

# Ignore every bridge entry, then expose only Experiment 1. bridge/thesis/
# stays local.
/bridge/*
!/bridge/.env.example
!/bridge/README.md
!/bridge/scripts/
!/bridge/data/
!/bridge/experiment1_baselineCodeguarder/

# Shared, small inputs used by Experiment 1.
/bridge/data/*
!/bridge/data/patcheval_dynamic_230_Python.json
!/bridge/data/authors_*_reference.json

# Preserve compact Experiment 1 evidence so the reported numbers are auditable:
# retrievals, prompts, model responses, patches, and consolidated evaluations.
!/bridge/experiment1_baselineCodeguarder/artifacts/
!/bridge/experiment1_baselineCodeguarder/artifacts/**
!/bridge/experiment1_baselineCodeguarder/data/
!/bridge/experiment1_baselineCodeguarder/data/**

# Logs are operational noise even when stored beside the retained evidence.
/bridge/experiment1_baselineCodeguarder/artifacts/*.log
